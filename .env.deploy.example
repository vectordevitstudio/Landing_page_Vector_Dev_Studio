# ──────────────────────────────────────────────────────────────────────
# Конфигурация деплоя. Docker Compose автоматически читает файл .env
# из этой папки. На сервере выполните:
#     cp .env.deploy.example .env
# и заполните значения. Файл .env в git НЕ коммитится (см. .gitignore).
# ──────────────────────────────────────────────────────────────────────

# Домен сайта: server_name в nginx + домен для выпуска TLS-сертификата.
DOMAIN=info.vectordev.ru

# Email для Let's Encrypt — туда придут уведомления об истечении сертификата.
CERTBOT_EMAIL=admin@vectordev.ru

# Тестовый (staging) сертификат Let's Encrypt без лимитов на количество запросов.
#   1 — для проверки настройки (браузер будет ругаться на сертификат — это норма)
#   0 — боевой сертификат
# Используется только скриптом deploy/init-letsencrypt.sh.
STAGING=0
